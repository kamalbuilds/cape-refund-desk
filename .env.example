# Copy to .env.local for local dev. Never commit real values. In production set these as platform secrets.
NEBIUS_API_KEY=            # Nebius Token Factory key (required for live runs; the recorded replay needs no key)
TAVILY_API_KEY=            # optional: rule-watch fetches CBP's page through Tavily Extract (falls back to a direct fetch)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1   # fallback host: https://api.tokenfactory.us-central1.nebius.com/v1
# ULTRA_MAX=22             # cap on Ultra explanations per run
# LIVE_RUNS_MAX=40         # live runs allowed per server instance (cost guard)
# MAX_LIVE_ENTRIES=120     # largest upload a live run accepts
# NEBIUS_PRICE_ULTRA_IN=1.00  NEBIUS_PRICE_ULTRA_OUT=3.00  NEBIUS_PRICE_LIGHTNING_IN=0.06  NEBIUS_PRICE_LIGHTNING_OUT=0.24   # USD per 1M tokens, for the receipt estimate
# DEV ONLY: NEMOTRON_PROVIDER=openrouter uses free-tier Nemotron on OpenRouter when Token Factory credit is out. Needs OPENROUTER_API_KEY in your local shell env.
# Refused on Vercel / NODE_ENV=production. Outputs go to the gitignored .dev-runs/ and are labelled provider=openrouter. Never use them in the submission or video. Default stays tokenfactory.
# NEMOTRON_PROVIDER=tokenfactory
